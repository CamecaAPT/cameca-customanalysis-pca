<UserControl x:Class="Cameca.CustomAnalysis.Pca.ProjectionGridsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Cameca.CustomAnalysis.Pca"
             xmlns:interface="clr-namespace:Cameca.CustomAnalysis.Interface;assembly=Cameca.CustomAnalysis.Interface"
             xmlns:controls="clr-namespace:Cameca.Extensions.Controls;assembly=Cameca.Extensions.Controls"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <local:SingleRenderDataValueConverter x:Key="SingleRenderDataValueConverter" />
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <local:BooleanToInverseVisibilityConverter x:Key="BooleanToInverseVisibilityConverter" />
    </UserControl.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <StackPanel Grid.Column="0" 
                    Grid.RowSpan="2"
                    Orientation="Vertical" 
                    HorizontalAlignment="Center"
                    Background="#efefef">
            <Button x:Name="PreviousGridButton" 
                 Content="Go to Previous Grid" 
                 Height="32" 
                 Width="160"
                 Click="PreviousGridButton_Click" 
                 Margin="10,10,10,10">
            </Button>
            <Button x:Name="AdvanceGridButton" 
                 Content="Advance To Next Grid" 
                 Height="32" 
                 Width="160"
                 Click="AdvanceGridButton_Click" 
                 Margin="10,10,10,10">
            </Button>
            <CheckBox x:Name="UseGridForPCAPhaseID" 
                 Content="Use Grid for PCA Phase ID" 
                 Height="32" 
                 Width="160"
                 Click="UseGridForPCAPhaseID_Click" 
                 Margin="10,10,10,10">
            </CheckBox>
            <TextBox x:Name="GridInfoText" 
                 Width="160"
                 Margin="10,10,10,10"
                 MaxHeight="250"
                 ScrollViewer.HorizontalScrollBarVisibility="Auto"
                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                 ScrollViewer.CanContentScroll="True">
            </TextBox>
 
        </StackPanel>
        <Label x:Name="GridLabel" 
                 Grid.Column="1" 
                 Grid.Row="0" 
                 Content="Grid Title" 
                 Height="32" 
                 Width="140" 
                 FontSize="16" 
                 FontFamily="Calibri"  
                 FontWeight="Bold"   
                 Background="White"   
                 Foreground="Black">
        </Label>


        <controls:Histogram2D x:Name="ProjectionGrid2dHistogramUntinted" 
                Visibility="{Binding MouseHovering, Converter={StaticResource BooleanToInverseVisibilityConverter}}"
                Grid.Column="2" 
                Grid.Row="1" 
                MouseEnter="ProjectionGrid2dHistogram_MouseLeave" 
                DataSource="{Binding SelectedGridRenderDataUntinted, RelativeSource={RelativeSource AncestorType=local:ProjectionGridsView}}"
                AxisXLabel="PCA dimension"
                AxisYLabel="PCA dimension"/>
        <controls:Histogram2D x:Name="ProjectionGrid2dHistogramTinted" 
                Visibility="{Binding MouseHovering, Converter={StaticResource BooleanToVisibilityConverter}}"
                Grid.Column="2" 
                Grid.Row="1" 
                MouseLeave="ProjectionGrid2dHistogram_MouseEnter" 
                DataSource="{Binding SelectedGridRenderDataTinted, RelativeSource={RelativeSource AncestorType=local:ProjectionGridsView}}"
                AxisXLabel="PCA dimension"
                AxisYLabel="PCA dimension"/>

    </Grid>
</UserControl>
