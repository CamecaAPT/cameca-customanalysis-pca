<UserControl x:Class="Cameca.CustomAnalysis.Pca.ClusteringView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Cameca.CustomAnalysis.Pca"
             xmlns:utils="clr-namespace:Cameca.CustomAnalysis.Utilities.Controls;assembly=Cameca.CustomAnalysis.Utilities"
             xmlns:controls="clr-namespace:Cameca.Extensions.Controls;assembly=Cameca.Extensions.Controls"
             xmlns:interface="clr-namespace:Cameca.CustomAnalysis.Interface;assembly=Cameca.CustomAnalysis.Interface"
             xmlns:behaviors="http://schemas.microsoft.com/xaml/behaviors"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800"
             DataContext="{Binding Node}">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <local:SingleRenderDataValueConverter x:Key="SingleRenderDataValueConverter" />
        <local:ClusterNameConverter x:Key="ClusterNameConverter" />
    </UserControl.Resources>

    <utils:ButtonOverlayControl ButtonContent="Update"
                                ButtonCommand="{Binding UpdateCommand}"
                                Name="Test"
                                OverlayVisibility="{Binding UpdateCommandCanExecute, Converter={StaticResource BooleanToVisibilityConverter}}">
        <ItemsControl x:Name="ComponentsItemControl"
                          ItemsSource="{Binding ItemsSource}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <local:SquareUniformGrid  />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type interface:IRenderData}">
                    <GroupBox>
                        <GroupBox.Header>
                            <MultiBinding Converter="{StaticResource ClusterNameConverter}">
                                <Binding Path="Name" />
                                <Binding Path="DataContext.NameMap"
                                         RelativeSource="{RelativeSource AncestorType=ItemsControl}"/>
                            </MultiBinding>
                        </GroupBox.Header>
                        <controls:Chart2D DataSource="{Binding Converter={StaticResource SingleRenderDataValueConverter}}"
                                          AxisYLabel="Probability"
                                          AxisXLabel="{Binding DataContext.TicPlotXAxisLabel, RelativeSource={RelativeSource AncestorType={x:Type local:ClusteringView}}, Mode=OneWay}">
                            <behaviors:Interaction.Triggers>
                                <behaviors:EventTrigger EventName="PreviewMouseWheel">
                                    <behaviors:InvokeCommandAction Command="{Binding DataContext.RebinCommand, RelativeSource={RelativeSource AncestorType={x:Type local:ClusteringView}}, Mode=OneWay}"
                                                                   PassEventArgsToCommand="True"/>
                                </behaviors:EventTrigger>
                            </behaviors:Interaction.Triggers>
                        </controls:Chart2D>
                    </GroupBox>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </utils:ButtonOverlayControl>
</UserControl>